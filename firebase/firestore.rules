rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // =========================================================================
    // USER DATA - Users can only access their own data
    // =========================================================================
    match /users/{userId} {
      // Allow read/write only if authenticated user matches document ID
      allow read, write: if request.auth != null && request.auth.uid == userId;
      
      // Workout Plans subcollection
      match /workoutPlans/{planId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
        
        // Workout Days within a plan
        match /workoutDays/{dayId} {
          allow read, write: if request.auth != null && request.auth.uid == userId;
          
          // Exercises within a workout day
          match /exercises/{exerciseId} {
            allow read, write: if request.auth != null && request.auth.uid == userId;
          }
        }
      }
      
      // Workout Sessions subcollection
      match /workoutSessions/{sessionId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
        
        // Exercise Completions within a session
        match /exerciseCompletions/{completionId} {
          allow read, write: if request.auth != null && request.auth.uid == userId;
        }
      }
      
      // Google Fit Tokens - Backend only (no direct client access)
      // These are accessed only via Firebase Admin SDK from the backend
      match /googleFitTokens/{tokenId} {
        allow read, write: if false; // Only accessible via Admin SDK
      }
    }
    
    // =========================================================================
    // GLOBAL READ-ONLY DATA
    // =========================================================================
    
    // Warmup Routines - Read-only for authenticated users
    match /warmupRoutines/{routineId} {
      allow read: if request.auth != null;
      allow write: if false; // Admin only via Admin SDK
    }
    
    // =========================================================================
    // DEFAULT DENY - Catch-all for undefined paths
    // =========================================================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
